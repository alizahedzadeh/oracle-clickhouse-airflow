# Copy this file to .env and adjust as needed.
# `docker compose` automatically loads .env from the project root.

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=oracle-clickhouse-airflow/airflow:latest
AIRFLOW__CORE__FERNET_KEY=
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# --- Oracle (local dev instance, gvenzl/oracle-free image) ---
ORACLE_PASSWORD=oracle_pw
ORACLE_APP_USER=app_user
ORACLE_APP_USER_PASSWORD=app_pw
ORACLE_HOST=oracle
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_pw
CLICKHOUSE_DB=analytics

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
