<clickhouse>
    <!-- Local dev tuning: keep the single-node container light and quiet.
         replace="1" makes this override any other listen_host from merged
         config files instead of appending to them, because this Docker
         environment has no IPv6 socket support and the base config's
         default IPv6 "::" listen_host fails to bind with "Address family
         for hostname not supported". Pin to IPv4-only. -->
    <listen_host replace="1">0.0.0.0</listen_host>
    <mark_cache_size>536870912</mark_cache_size>
    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>
</clickhouse>
