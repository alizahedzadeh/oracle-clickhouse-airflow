{
  "title": "ClickHouse Overview",
  "uid": "clickhouse-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Queries / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_Query[1m])",
          "legendFormat": "queries/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Currently Running Queries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ClickHouseMetrics_Query",
          "legendFormat": "running queries",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Resident Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ClickHouseAsyncMetrics_MemoryResident",
          "legendFormat": "resident memory",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Inserted Rows / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_InsertedRows[1m])",
          "legendFormat": "rows inserted/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Active Merges",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ClickHouseMetrics_Merge",
          "legendFormat": "active merges",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Uptime (seconds)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ClickHouseAsyncMetrics_Uptime",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ]
    }
  ]
}
